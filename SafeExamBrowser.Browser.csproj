<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>SafeExamBrowser.Browser</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <None Remove="SafeExamBrowser.Browser.Content.BlockedContent.html" />
    <None Remove="SafeExamBrowser.Browser.Content.BlockedPage.html" />
    <None Remove="SafeExamBrowser.Browser.Content.Api.js" />
    <None Remove="SafeExamBrowser.Browser.Content.Clipboard.js" />
    <None Remove="SafeExamBrowser.Browser.Content.PageZoom.js" />
    <EmbeddedResource Include="SafeExamBrowser.Browser.Content.BlockedContent.html" LogicalName="SafeExamBrowser.Browser.Content.BlockedContent.html" />
    <EmbeddedResource Include="SafeExamBrowser.Browser.Content.BlockedPage.html" LogicalName="SafeExamBrowser.Browser.Content.BlockedPage.html" />
    <EmbeddedResource Include="SafeExamBrowser.Browser.Content.Api.js" LogicalName="SafeExamBrowser.Browser.Content.Api.js" />
    <EmbeddedResource Include="SafeExamBrowser.Browser.Content.Clipboard.js" LogicalName="SafeExamBrowser.Browser.Content.Clipboard.js" />
    <EmbeddedResource Include="SafeExamBrowser.Browser.Content.PageZoom.js" LogicalName="SafeExamBrowser.Browser.Content.PageZoom.js" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="SafeExamBrowser.Browser.Contracts" />
    <Reference Include="SafeExamBrowser.Applications.Contracts" />
    <Reference Include="SafeExamBrowser.Configuration.Contracts" />
    <Reference Include="SafeExamBrowser.UserInterface.Contracts" />
    <Reference Include="SafeExamBrowser.Logging.Contracts" />
    <Reference Include="SafeExamBrowser.WindowsApi.Contracts" />
    <Reference Include="SafeExamBrowser.Settings" />
    <Reference Include="SafeExamBrowser.I18n.Contracts" />
    <Reference Include="SafeExamBrowser.Core.Contracts" />
    <Reference Include="CefSharp" />
    <Reference Include="CefSharp.WinForms" />
    <Reference Include="System.Net.Http" />
    <Reference Include="Newtonsoft.Json" />
    <Reference Include="CefSharp.Core" />
    <Reference Include="System.Core" />
    <Reference Include="Syroot.KnownFolders" />
  </ItemGroup>
</Project>